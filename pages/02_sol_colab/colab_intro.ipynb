      "source": [
        "# 9. Animacja wahadła i zapis do video.mp4\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from matplotlib import animation\n",
        "from IPython.display import HTML\n",
        "\n",
        "# Parametry fizyczne\n",
        "g = 9.81\n",
        "L = 1.0\n",
        "t = np.linspace(0, 10, 200)\n",
        "theta = 0.8 * np.cos(np.sqrt(g / L) * t)  # proste wahadło\n",
        "\n",
        "x = L * np.sin(theta)\n",
        "y = -L * np.cos(theta)\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(6, 6))\n",
        "ax.set_xlim(-1.2, 1.2)\n",
        "ax.set_ylim(-1.2, 0.2)\n",
        "ax.set_aspect('equal')\n",
        "ax.grid(True)\n",
        "\n",
        "line, = ax.plot([], [], 'o-', lw=2, color='navy')\n",
        "trace, = ax.plot([], [], '-', lw=1, color='lightblue', alpha=0.7)\n",
        "\n",
        "def init():\n",
        "    line.set_data([], [])\n",
        "    trace.set_data([], [])\n",
        "    return line, trace\n",
        "\n",
        "def animate(i):\n",
        "    line.set_data([0, x[i]], [0, y[i]])\n",
        "    trace.set_data(x[:i], y[:i])\n",
        "    return line, trace\n",
        "\n",
        "anim = animation.FuncAnimation(fig, animate, init_func=init, frames=len(t), interval=50, blit=True)\n",
        "\n",
        "# Zapisujemy do video.mp4 (wymaga ffmpeg w systemie)\n",
        "writer = animation.FFMpegWriter(fps=20, metadata=dict(artist='Colab'), bitrate=1800)\n",
        "anim.save('video.mp4', writer=writer)\n",
        "plt.close(fig)\n",
        "\n",
        "# Osadzenie wideo w notebooku\n",
        "from IPython.display import Video\n",
        "Video('video.mp4', embed=True, width=400)"
      ],
      "execution_count": 29,

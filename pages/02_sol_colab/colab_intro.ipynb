      "source": [
        "# 10. Konwersja video.mp4 na video.gif\n",
        "import imageio\n",
        "\n",
        "reader = imageio.get_reader('video.mp4')\n",
        "fps = reader.get_meta_data().get('fps', 20)\n",
        "\n",
        "writer = imageio.get_writer('video.gif', fps=fps)\n",
        "for frame in reader:\n",
        "    writer.append_data(frame)\n",
        "writer.close()\n",
        "print(\"Konwersja zakończona. Animacja została zapisana do pliku video.gif.\")"
      ],

      "source": [
        "# 11. Zmodyfikowana krzywa parametryczna (Lissajous 3D) i zapis do parametric_curve.png\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from mpl_toolkits.mplot3d import Axes3D\n",
        "\n",
        "t = np.linspace(0, 2 * np.pi, 1000)\n",
        "\n",
        "# Zmodyfikowane równania parametryczne (Krzywa Lissajous 3D)\n",
        "x = np.sin(3 * t)\n",
        "y = np.cos(4 * t)\n",
        "z = np.sin(5 * t)\n",
        "\n",
        "fig = plt.figure(figsize=(8, 8))\n",
        "ax = fig.add_subplot(111, projection='3d')\n",
        "ax.plot(x, y, z, label=\"Krzywa Lissajous 3D\", color='purple', lw=2)\n",
        "ax.set_title(\"Zmodyfikowana Krzywa Parametryczna (3D)\", fontsize=14)\n",
        "ax.set_xlabel(\"x(t) = sin(3t)\")\n",
        "ax.set_ylabel(\"y(t) = cos(4t)\")\n",
        "ax.set_zlabel(\"z(t) = sin(5t)\")\n",
        "ax.legend()\n",
        "\n",
        "plt.savefig('parametric_curve.png', dpi=150)\n",
        "plt.show()\n",
        "print(\"Krzywa została zapisana do pliku parametric_curve.png.\")"
      ],
